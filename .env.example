# Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Get free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID or Channel ID where updates should be sent
# Can be your personal user ID or @your_channel_name
TELEGRAM_CHAT_ID=your_chat_or_channel_id_here

# Monitoring interval in minutes
CHECK_INTERVAL_MINUTES=30
